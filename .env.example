# ============================================================================
# INCONSARQ Web — Variables de entorno
# ============================================================================
# Copiá este archivo como `.env` y completá los valores reales.
# El archivo `.env` está ignorado por git (revisar .gitignore) — NUNCA lo subas.
#
# En Vercel: Project Settings → Environment Variables → agregar las 3 keys
# para que se inyecten en cada build de producción.
# ============================================================================

# --- EmailJS (formulario de contacto) ---------------------------------------
# Dashboard: https://dashboard.emailjs.com
# Service ID:  Email Services → tu servicio   (formato service_xxxxxxx)
# Template ID: Email Templates → tu template  (formato template_xxxxxxx)
# Public Key:  Account → General → API Keys   (string corto alfanumérico)

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
